{
  "name": "ROS 2 Workspace humble-ros-base",
  "remoteUser": "rosdev",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "USERNAME": "rosdev",
      "GID": "1000",
      "UID": "1000"
    }
  },

  // Browser-based desktop so RViz / MoveIt / joint_state_publisher_gui work
  // identically on macOS, Windows and Linux. Open http://localhost:6080
  // (default password: vscode). This replaces the previous WSL-only X11 setup.
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "version": "latest",
      "noVncVersion": "1.2.0",
      "password": "vscode",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "forwardPorts": [6080, 5901],
  "portsAttributes": {
    "6080": { "label": "Desktop (noVNC)" },
    "5901": { "label": "VNC" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-vscode.cpptools-extension-pack",
        "ms-iot.vscode-ros",
        "smilerobotics.urdf",
        "redhat.vscode-xml",
        "tamasfe.even-better-toml",
        "timonwong.shellcheck",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "files.associations": {
          "*.rviz": "yaml",
          "*.srdf": "xml",
          "*.urdf": "xml",
          "*.xacro": "xml"
        }
      }
    }
  },

  "workspaceFolder": "/home/rosdev/ros2_ws",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/rosdev/ros2_ws/src,type=bind",

  "mounts": [
    // Optional, Linux host only: share the host X server instead of noVNC.
    // Also set "DISPLAY": "${localEnv:DISPLAY}" in containerEnv below.
    // "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
    //
    // Optional, Windows + WSLg only:
    // "source=/mnt/wslg,target=/mnt/wslg,type=bind"
  ],

  "containerEnv": {
    // ":1" is the display served by the desktop-lite feature above.
    // For a Linux host X server use "${localEnv:DISPLAY}".
    // For macOS + XQuartz use "host.docker.internal:0".
    "DISPLAY": ":1",
    // Software rendering: containers have no GPU passthrough by default.
    "LIBGL_ALWAYS_SOFTWARE": "1",
    // DDS discovery. Keep nodes on one domain; raw TCP to the robot is
    // unaffected by this and works fine over Docker's bridge network.
    "ROS_LOCALHOST_ONLY": "0",
    "ROS_DOMAIN_ID": "0"
  },

  "runArgs": [
    // NOTE: "--network=host" was removed. It is a Linux-only Docker feature and
    // is not supported by Docker Desktop on macOS or Windows, which is why this
    // container did not come up on those hosts. Bridge networking still reaches
    // the robot over TCP. Re-add it only on a native Linux host if you need
    // DDS discovery with nodes running outside the container.
    "--ipc=host",
    // Allow ros2_control to request real-time scheduling priorities.
    "--cap-add=SYS_NICE",
    "--ulimit",
    "rtprio=99",
    "--ulimit",
    "memlock=-1:-1"
  ],

  // Resolve declared package dependencies on first create. Non-fatal so the
  // container still opens if the network or a rosdep key is unavailable.
  "postCreateCommand": "sudo apt-get update -q || true; rosdep update --rosdistro $ROS_DISTRO || true; rosdep install --from-paths src --ignore-src -r -y || true"
}
